#!/usr/bin/python3
"""workstation-proxy: the relay between the *.<domain> proxy (hq-caddy, on its own box)
and this container.

The proxy itself runs elsewhere and takes its sites from Git (homelab-proxy). It reaches
services that listen only on this container's loopback, and the static folders here,
through this relay. Off unless PROXY_RELAY_PORT is set. Settings (environment):
  PROXY_RELAY_PORT           plain HTTP on this port, answering only PROXY_RELAY_TRUST:
                             - a numeric X-Hq-Relay-Port header (hq-caddy `relay`)
                               forwards to 127.0.0.1:<port>;
                             - X-Hq-Relay-Root (hq-caddy `relay_root`) serves that
                               folder, if it is under /workspace and no part of its
                               path starts with a dot;
                             - otherwise (hq-caddy `relay_files`) www/<name>/ by the
                               first label of the Host header.
  PROXY_RELAY_TRUST          the proxy's address(es), comma/space separated; everyone
                             else gets 403 (all of them while this is unset). Their
                             X-Forwarded-* headers are kept, so apps still see https.
  PROXY_BIND                 addresses to listen on, comma/space separated (default: all)
  PROXY_CONFIG_DIR           folder holding www/ (default /workspace/proxy)
  PROXY_STATIC_ALLOWED       symlinks in www/ must point inside this (default /workspace)
  PROXY_ADMIN                Caddy admin API address (default localhost:2019)

www/<name>/ folders are picked up within a minute (the supervisor runs
`reload --if-changed`). Dotfiles are never served.

Commands:
  status   whether the relay runs, what it serves, and the last error
  sites    list the www/ folders it serves and the ones it skips (with the reason)
  reload   rebuild, validate and apply (--if-changed: only when www/ changed)
  show     print the generated Caddy configuration
  logs     show recent Caddy log lines (-n N)
  run      (used by the image's supervisor) build and run Caddy in the foreground
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/paseo"))
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "workstation-proxy"
ACTIVE = STATE / "active"
CANDIDATE = STATE / "candidate"
LOG = STATE / "caddy.log"
ERROR = STATE / "last-error.txt"
REPORT = STATE / "report.json"
WORKSPACE = Path(os.environ.get("PROXY_STATIC_ALLOWED", "/workspace"))
ADMIN = os.environ.get("PROXY_ADMIN", "localhost:2019")  # Caddy admin API (loopback)
NAME = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
RETIRED = ("PROXY_DOMAIN", "PROXY_LAN_DOMAIN", "PROXY_MANAGE_DNS", "PROXY_DNS_TARGET", "PROXY_CHECK_INTERVAL")


def env(name, default=""):
    return os.environ.get(name, default).strip()


def settings():
    retired = [name for name in RETIRED if env(name)]
    problems = [f"{', '.join(retired)} no longer used: this image only runs the relay "
                "(the proxy is hq-caddy, configured through homelab-proxy)"] if retired else []
    return {
        "bind": [a for a in re.split(r"[,\s]+", env("PROXY_BIND")) if a],
        "config": Path(env("PROXY_CONFIG_DIR", "/workspace/proxy")),
        "relay_port": env("PROXY_RELAY_PORT") if env("PROXY_RELAY_PORT").isdigit() else "",
        "relay_trust": [a for a in re.split(r"[,\s]+", env("PROXY_RELAY_TRUST")) if a],
        "problems": problems,
    }


def enabled():
    return bool(settings()["relay_port"])


# ----- static folders --------------------------------------------------------

def inside(path, root):
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def check_static(entry):
    """Return (resolved root, None) if www/<name> may be served, else (None, reason)."""
    target = entry.resolve()
    if not target.is_dir():
        return None, "not a directory"
    if entry.is_symlink():
        if not inside(target, WORKSPACE) or inside(target, HOME):
            return None, f"symlink points outside {WORKSPACE}"
    checked = 0
    for directory, dirnames, filenames in os.walk(target, followlinks=False):
        for name in dirnames + filenames:
            checked += 1
            if checked > 50000:
                return None, "too many files to check (over 50000)"
            path = Path(directory) / name
            if entry.is_symlink() and (name == ".git" or name.startswith(".env")):
                return None, f"contains {path.relative_to(target)} (link only build output)"
            if path.is_symlink() and not inside(path.resolve(), target):
                return None, f"{path.relative_to(target)} links outside the folder"
    return target, None


def collect(cfg):
    """The www/ folders: which are served and which are skipped (with the reason)."""
    www_dir = cfg["config"] / "www"
    static, skipped = [], []
    for entry in sorted(www_dir.iterdir()) if www_dir.is_dir() else []:
        name = entry.name
        if name.startswith("."):
            continue
        if not NAME.match(name):
            skipped.append({"name": name, "source": f"www/{name}", "reason": "invalid name (a-z, 0-9, -)"})
            continue
        root, reason = check_static(entry)
        if root:
            static.append({"name": name, "source": f"www/{name}", "root": str(root)})
        else:
            skipped.append({"name": name, "source": f"www/{name}", "reason": reason})
    return static, skipped


# ----- configuration ---------------------------------------------------------

def quote(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def caddyfile(cfg, static):
    out = ["{", f"\tadmin {ADMIN}", "\tauto_https off", "\tgrace_period 10s"]
    if cfg["bind"]:
        out.append("\tdefault_bind " + " ".join(cfg["bind"]))
    if cfg["relay_trust"]:
        # Keep the proxy's X-Forwarded-* (its https) instead of replacing them.
        out += ["\tservers {", "\t\ttrusted_proxies static " + " ".join(cfg["relay_trust"]), "\t}"]
    out += ["\tlog default {", "\t\toutput stderr", "\t\tformat console", "\t}",
            "\tlog file {", f"\t\toutput file {quote(LOG)} {{", "\t\t\troll_size 5MiB", "\t\t\troll_keep 3",
            "\t\t}", "\t\tformat json", "\t}", "}", "",
            "# Static folders: dotfiles are never served.", "(static_files) {",
            "\t@dotfiles path */.*", "\trespond @dotfiles 404", "\troot * {args[0]}",
            "\tfile_server {", "\t\thide .*", "\t}", "}", ""]
    # Only PROXY_RELAY_TRUST may use it. A numeric X-Hq-Relay-Port picks a loopback port;
    # X-Hq-Relay-Root a folder under /workspace (no ".." or hidden parts); otherwise
    # www/<name>/ by the Host's first label. A pass-through hop: flush every write so
    # streams aren't held back.
    out += ["# Relay for the proxy running elsewhere (hq-caddy `relay`, `relay_root`, `relay_files`)",
            f"http://:{cfg['relay_port']} {{", "\troute {"]
    if cfg["relay_trust"]:
        out += ["\t\t@outsider not remote_ip " + " ".join(cfg["relay_trust"]), '\t\trespond @outsider "Forbidden" 403']
    else:
        out += ['\t\trespond "Forbidden: PROXY_RELAY_TRUST is not set" 403']
    out += ["\t\t@port header_regexp X-Hq-Relay-Port ^[0-9]{1,5}$",
            "\t\treverse_proxy @port 127.0.0.1:{header.X-Hq-Relay-Port} {", "\t\t\theader_up -X-Hq-Relay-Port",
            "\t\t\tflush_interval -1", "\t\t}",
            "\t\t@root header_regexp X-Hq-Relay-Root ^/workspace(/[A-Za-z0-9_@+=-][A-Za-z0-9._@+=-]*)+/?$",
            "\t\thandle @root {", "\t\t\timport static_files {header.X-Hq-Relay-Root}", "\t\t}"]
    for index, item in enumerate(static):
        out += [f"\t\t@www{index} expression {{host}}.startsWith({quote(item['name'] + '.')})",
                f"\t\thandle @www{index} {{", f"\t\t\timport static_files {quote(item['root'])}", "\t\t}"]
    out += ['\t\trespond "Unknown static site" 404', "\t}", "}", ""]
    return "\n".join(out) + "\n"


def build(target, cfg):
    """Write a configuration directory; return the report dict."""
    static, skipped = collect(cfg)
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    (target / "Caddyfile").write_text(caddyfile(cfg, static))
    # Normalise formatting so Caddy does not warn about it on every start.
    subprocess.run(["caddy", "fmt", "--overwrite", str(target / "Caddyfile")], capture_output=True)
    return {"relay_port": cfg["relay_port"], "relay_trust": cfg["relay_trust"], "bind": cfg["bind"],
            "problems": cfg["problems"], "static": static, "skipped": skipped}


def caddy(*args):
    return subprocess.run(["caddy", *args], capture_output=True, text=True)


def validate(directory):
    result = caddy("validate", "--config", str(directory / "Caddyfile"), "--adapter", "caddyfile")
    return result.returncode == 0, (result.stderr or result.stdout).strip()


def promote(report):
    """Replace the active configuration with the validated candidate."""
    old = STATE / "previous"
    if old.exists():
        shutil.rmtree(old)
    if ACTIVE.exists():
        ACTIVE.rename(old)
    CANDIDATE.rename(ACTIVE)
    REPORT.write_text(json.dumps(report, indent=2) + "\n")
    if old.exists():
        shutil.rmtree(old)


def prepare(cfg):
    """Build and validate a candidate, then promote it. Returns (ok, error message)."""
    STATE.mkdir(parents=True, exist_ok=True)
    report = build(CANDIDATE, cfg)
    ok, message = validate(CANDIDATE)
    if not ok:
        ERROR.write_text(message + "\n")
        shutil.rmtree(CANDIDATE, ignore_errors=True)
        return False, message
    ERROR.unlink(missing_ok=True)
    promote(report)
    return True, ""


def running():
    try:
        with urllib.request.urlopen(f"http://{ADMIN}/config/", timeout=2):
            return True
    except OSError:
        return False


def load_report():
    try:
        return json.loads(REPORT.read_text())
    except (OSError, ValueError):
        return None


# ----- commands --------------------------------------------------------------

def require_enabled():
    if not enabled():
        print("workstation-proxy: disabled (set PROXY_RELAY_PORT to run the relay)")
        sys.exit(0)


def report_problems(cfg):
    for problem in cfg["problems"]:
        print(f"warning: {problem}")


def cmd_reload(args):
    require_enabled()
    cfg = settings()
    if "--if-changed" in args:
        report = load_report()
        if report and running() and list(collect(cfg)) == [report["static"], report["skipped"]]:
            return 0
    report_problems(cfg)
    ok, message = prepare(cfg)
    if not ok:
        print("configuration INVALID; the running configuration is unchanged:\n" + message)
        return 1
    if running():
        result = caddy("reload", "--config", str(ACTIVE / "Caddyfile"), "--adapter", "caddyfile",
                       "--address", ADMIN)
        if result.returncode != 0:
            print("reload failed; Caddy keeps its previous configuration:\n" + result.stderr.strip())
            return 1
        print("reloaded")
    else:
        print("configuration updated; Caddy is not running yet (it starts with the container)")
    for skip in json.loads(REPORT.read_text())["skipped"]:
        print(f"skipped {skip['source']}: {skip['reason']}")
    return 0


def cmd_sites(_):
    require_enabled()
    report = load_report()
    if not report:
        print("no configuration yet: run workstation-proxy reload")
        return 1
    for item in report["static"]:
        print(f"{item['name']:20} served    {item['source']} -> {item['root']}")
    for skip in report["skipped"]:
        print(f"{skip['name']:20} skipped   {skip['source']}: {skip['reason']}")
    print("Publish one on the proxy with a homelab-proxy site file: import relay_files <name>")
    return 0


def cmd_status(_):
    if not enabled():
        print("disabled (set PROXY_RELAY_PORT to run the relay)")
        return 0
    cfg, report = settings(), load_report()
    report_problems(cfg)
    print(f"relay: port {cfg['relay_port']}, bind={' '.join(cfg['bind']) or 'all'}, "
          f"trusts {' '.join(cfg['relay_trust']) or 'nobody (PROXY_RELAY_TRUST is not set)'}")
    print("caddy: running" if running() else "caddy: NOT running (see workstation-proxy logs)")
    if report:
        print(f"www: {len(report['static'])} served, {len(report['skipped'])} skipped (details: workstation-proxy sites)")
    if ERROR.exists():
        print("last error:\n" + ERROR.read_text().strip())
    return 0 if running() else 1


def cmd_logs(args):
    lines = int(args[args.index("-n") + 1]) if "-n" in args else 40
    if not LOG.exists():
        print("no log yet")
        return 0
    for line in LOG.read_text(errors="replace").splitlines()[-lines:]:
        try:
            entry = json.loads(line)
            extra = {k: v for k, v in entry.items() if k not in ("ts", "level", "logger", "msg")}
            print(f"{entry.get('level', '?'):5} {entry.get('logger', '')}: {entry.get('msg', '')} {json.dumps(extra) if extra else ''}")
        except ValueError:
            print(line)
    return 0


def cmd_show(_):
    require_enabled()
    STATE.mkdir(parents=True, exist_ok=True)
    build(CANDIDATE, settings())
    print((CANDIDATE / "Caddyfile").read_text(), end="")
    shutil.rmtree(CANDIDATE, ignore_errors=True)
    return 0


def cmd_run(_):
    require_enabled()
    cfg = settings()
    report_problems(cfg)
    for name in ("status.json", "dns.json", "checks.lock"):  # left by the old built-in proxy
        (STATE / name).unlink(missing_ok=True)
    ok, message = prepare(cfg)
    if not ok:
        print("workstation-proxy: no valid configuration; not starting Caddy:\n" + message, file=sys.stderr, flush=True)
        return 1
    os.execvp("caddy", ["caddy", "run", "--config", str(ACTIVE / "Caddyfile"), "--adapter", "caddyfile"])


COMMANDS = {"status": cmd_status, "sites": cmd_sites, "reload": cmd_reload, "show": cmd_show,
            "logs": cmd_logs, "run": cmd_run}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help") else 2)
    sys.exit(COMMANDS[sys.argv[1]](sys.argv[2:]))
